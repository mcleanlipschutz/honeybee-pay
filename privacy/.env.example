# Public Privy configuration. Never put the app secret or wallet password here.
HONEYBEE_PRIVY_APP_ID=
HONEYBEE_PRIVY_VERIFICATION_KEY_FILE=.honeybee/privy-verification.pub
HONEYBEE_ACCOUNT_DIRECTORY=.honeybee/accounts
HONEYBEE_ACCOUNT_PORT=4173
# Optional read-only private-wallet synchronization. Never a seed or password.
HONEYBEE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HONEYBEE_POI_URL=https://ppoi.fdi.network
